# ============================================================
# MARINA — Produção NGHair
# Arquivo: /home/marina/.env no VPS
# PREENCHA os campos marcados com <<< PREENCHER >>>
# ============================================================

DEBUG=False
SECRET_KEY=<<<GERE_COM: openssl rand -hex 32>>>

# Banco de Dados (SQLite para início, PostgreSQL para escala)
DATABASE_URL=sqlite:///./data/marina.db

# ── Trinks API ───────────────────────────────────────────────
# Token em: https://www.trinks.com/MinhaArea/MeuCadastro
TRINKS_API_KEY=<<<COLE_SEU_TOKEN_TRINKS_AQUI>>>
TRINKS_API_URL=https://api.trinks.com
TRINKS_ESTABELECIMENTO_ID=20181
TRINKS_SYNC_INTERVAL=3600

# ── Google Gemini ────────────────────────────────────────────
# Chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=<<<COLE_SUA_CHAVE_GEMINI_AQUI>>>
GEMINI_MODEL=gemini-2.0-flash

# ── Evolution API / WhatsApp ──────────────────────────────────
# A Evolution API roda localmente no Docker (porta 8080)
EVOLUTION_API_URL=http://localhost:8080
# Gere a API Key após subir o Docker: qualquer string aleatória forte
EVOLUTION_API_KEY=<<<GERE_COM: openssl rand -hex 16>>>
WHATSAPP_INSTANCE_NAME=nghair

# ── Domínio / Webhook ─────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WEBHOOK_URL=https://nghair.com.br/webhook/whatsapp

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/marina.log

# ── Persona ──────────────────────────────────────────────────
MARINA_NAME=Marina
MARINA_SALAO=NGHair
MARINA_TONE=profissional e amigável

# ── Memória ──────────────────────────────────────────────────
MEMORY_RETENTION_DAYS=365
MAX_CONVERSATION_HISTORY=20
