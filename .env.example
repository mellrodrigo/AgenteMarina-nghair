# ============================================================
# MARINA - Agente IA NGHair  |  Arquivo de Configuração
# Copie para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env no git
# ============================================================

# Configurações Gerais
DEBUG=False
SECRET_KEY=gere-com-openssl-rand-hex-32

# Banco de Dados
DATABASE_URL=sqlite:///./data/marina.db
# Para produção com PostgreSQL:
# DATABASE_URL=postgresql://marina:SENHA_SEGURA@localhost/marina

# ── Trinks API REST ─────────────────────────────────────────
# Token disponível em: https://www.trinks.com/MinhaArea/MeuCadastro
TRINKS_API_KEY=seu-token-trinks-aqui
TRINKS_API_URL=https://api.trinks.com
TRINKS_SYNC_INTERVAL=3600

# ── Google Gemini ────────────────────────────────────────────
GEMINI_API_KEY=sua-chave-gemini-aqui
GEMINI_MODEL=gemini-2.0-flash

# ── Evolution API / WhatsApp ──────────────────────────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-chave-evolution-aqui
WHATSAPP_INSTANCE_NAME=nghair

# ── API ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# URL pública do webhook (HTTPS obrigatório em produção)
API_WEBHOOK_URL=https://nghair.com.br/webhook/whatsapp

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/marina.log

# ── Persona ──────────────────────────────────────────────────
MARINA_NAME=Marina
MARINA_SALAO=NGHair
MARINA_TONE=profissional e amigável

# ── Multi-salão ───────────────────────────────────────────────
# Salão 1 — ex: Brooklin (instância Evolution padrão)
SALON_1_NOME=NGHair Brooklin
SALON_1_INSTANCE=NGHairAI
SALON_1_TRINKS_API_KEY=      # deixe vazio para usar TRINKS_API_KEY global
SALON_1_TRINKS_ESTABELECIMENTO_ID=20181

# Salão 2 — ex: Campo Belo
SALON_2_NOME=NGHair Campo Belo
SALON_2_INSTANCE=NGHairCampoBelo   # nome da instância Evolution deste salão
SALON_2_TRINKS_API_KEY=            # token Trinks do estabelecimento Campo Belo
SALON_2_TRINKS_ESTABELECIMENTO_ID= # ID Trinks do estabelecimento Campo Belo

# ── Modo Staff ───────────────────────────────────────────────
# Telefones dos funcionários (com DDI 55) separados por vírgula
# Ex: STAFF_PHONES=5511999990001,5511999990002
STAFF_PHONES=

# ── Memória ──────────────────────────────────────────────────
MEMORY_RETENTION_DAYS=365
MAX_CONVERSATION_HISTORY=20
